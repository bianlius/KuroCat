#include <windows.h>
#include "src/ResourceIds.h"

#ifdef KUROCAT_EMBED_MANIFEST
1 RT_MANIFEST "app.manifest"
#endif

IDR_DORAEMON_HEAD          RCDATA "../Resources/Doraemon/head.png"
IDR_DORAEMON_BODY          RCDATA "../Resources/Doraemon/body.png"
IDR_DORAEMON_HAND          RCDATA "../Resources/Doraemon/hand.png"
IDR_DORAEMON_RIGHT_FOOT    RCDATA "../Resources/Doraemon/foot-right.png"
IDR_DORAEMON_SHOULDER_MASK RCDATA "../Resources/Doraemon/shoulder-mask.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,3,7,0
 PRODUCTVERSION 1,3,7,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "KuroCat Desktop Pet"
            VALUE "FileVersion", "1.3.7"
            VALUE "OriginalFilename", "KuroCat.exe"
            VALUE "ProductName", "KuroCat"
            VALUE "ProductVersion", "1.3.7"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
